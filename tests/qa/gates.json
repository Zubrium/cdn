{
  "schema_version": 1,
  "coverage_min_percent": 60,
  "coverage_scope": "executable",
  "integration": "explicit",
  "gates": [
    {
      "id": "ledger",
      "label": "Website scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/website-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "core-ledger",
      "label": "Core scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/core-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "e2e-ledger",
      "label": "Website/Router E2E scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/e2e-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "obs-ledger",
      "label": "Observability scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/obs-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "cache-router-ledger",
      "label": "Router cache scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/cache-router-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "concurrency-admission-ledger",
      "label": "Concurrency admission scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/concurrency-admission-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "conc-limits-ledger",
      "label": "Concurrency limits, metrics and topology scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/conc-limits-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "core-cache-ledger",
      "label": "Core cache and cache/concurrency scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/core-cache-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "content-ledger",
      "label": "Content scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/content-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "forms-ledger",
      "label": "Forms scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/forms-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "loader-ledger",
      "label": "Loader scenario ledger validation",
      "command": ["python3", "tests/qa/scenario-ledger.py", "tests/qa/loader-scenarios.json"],
      "cwd": "."
    },
    {
      "id": "obs-scenarios",
      "label": "Observability OBS-001..010 executable scenarios",
      "command": ["tests/qa/run-obs-red.sh"],
      "cwd": "."
    },
    {
      "id": "cache-router-scenarios",
      "label": "Router cache executable scenarios",
      "command": ["tests/qa/run-cache-router-red.sh", "go"],
      "cwd": "."
    },
    {
      "id": "concurrency-admission-scenarios",
      "label": "Concurrency admission executable scenarios",
      "command": ["tests/qa/run-concurrency-admission-red.sh", "unit"],
      "cwd": "."
    },
    {
      "id": "conc-limits-scenarios",
      "label": "Concurrency limits, metrics and topology executable scenarios",
      "command": ["tests/qa/run-conc-limits-red.sh", "all"],
      "cwd": "."
    },
    {
      "id": "core-cache-scenarios",
      "label": "Core cache and cache/concurrency executable scenarios (unit and race)",
      "command": ["tests/qa/run-core-cache-red.sh", "all"],
      "cwd": "."
    },
    {
      "id": "content-scenarios",
      "label": "Content executable scenarios",
      "command": ["tests/qa/run-content-red.sh", "go"],
      "cwd": "."
    },
    {
      "id": "forms-scenarios",
      "label": "Forms executable scenarios",
      "command": ["tests/qa/run-forms-red.sh", "go"],
      "cwd": "."
    },
    {
      "id": "loader-scenarios",
      "label": "Loader executable scenarios",
      "command": ["tests/qa/run-loader-red.sh", "go"],
      "cwd": "."
    },
    {
      "id": "website-unit",
      "label": "Website acceptance unit scenarios",
      "command": ["tests/qa/run-website-red.sh", "unit"],
      "cwd": "."
    },
    {
      "id": "website-contract",
      "label": "Website acceptance contract scenarios",
      "command": ["tests/qa/run-website-red.sh", "contract"],
      "cwd": "."
    },
    {
      "id": "website-integration",
      "label": "Website acceptance integration scenarios (disposable resources)",
      "command": ["tests/qa/run-website-red.sh", "integration"],
      "cwd": ".",
      "requires_env": [
        "WEBSITE_TEST_DISPOSABLE",
        "WEBSITE_TEST_RUN_ID",
        "WEBSITE_TEST_POSTGRES_DSN",
        "WEBSITE_TEST_POSTGRES_MIGRATION_DSN",
        "WEBSITE_TEST_S3_BUCKET"
      ]
    },
    {
      "id": "core-integration",
      "label": "Core acceptance integration scenarios (disposable PostgreSQL)",
      "command": ["tests/qa/run-core-red.sh", "integration"],
      "cwd": ".",
      "requires_env": [
        "TEST_CORE_OWNER_TASK_RESULT_DATABASE_URL"
      ]
    },
    {
      "id": "boundary-lint",
      "label": "Module boundary and profile lint",
      "command": ["make", "lint-core-boundary"],
      "cwd": "."
    },
    {
      "id": "frontend-typecheck",
      "label": "Admin TypeScript typecheck",
      "command": ["pnpm", "typecheck"],
      "cwd": "frontend"
    },
    {
      "id": "frontend-lint",
      "label": "Admin ESLint",
      "command": ["pnpm", "lint"],
      "cwd": "frontend"
    },
    {
      "id": "frontend-test",
      "label": "Admin Vitest suite",
      "command": ["pnpm", "test"],
      "cwd": "frontend"
    },
    {
      "id": "frontend-build",
      "label": "Admin production build",
      "command": ["pnpm", "build"],
      "cwd": "frontend",
      "requires_opt_in": "with-build"
    }
  ],
  "go_checks": [
    {"id": "go-test", "command": ["go", "test", "./..."]},
    {"id": "go-vet", "command": ["go", "vet", "./..."]},
    {"id": "go-build", "command": ["go", "build", "./..."]}
  ]
}
