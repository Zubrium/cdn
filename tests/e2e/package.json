{
  "name": "website-engine-router-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone live Playwright harness for Website publication and page retirement E2E scenarios.",
  "scripts": {
    "test": "node node_modules/@playwright/test/cli.js test",
    "test:ready": "node node_modules/@playwright/test/cli.js test specs/ready.spec.ts",
    "test:pub": "node node_modules/@playwright/test/cli.js test specs/publication.spec.ts",
    "test:ret": "node node_modules/@playwright/test/cli.js test specs/retirement.spec.ts",
    "test:ledger": "GOWORK=off go test -v -count=1 ./..."
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "20.19.9"
  }
}
