# Пример конфигурации для compose --profile observability.
# Скопируйте в main/config.observability.yaml (локальный файл не коммитить):
#   cp main/config.observability.yaml.example main/config.observability.yaml
# Секреты задаются только переменными окружения; в YAML только их имена.
# Адреса сервисов — внутри docker network compose.

core:
  database_url_env: ZUBRIUM_DATABASE_URL
  migration_database_url_env: ZUBRIUM_MIGRATION_DATABASE_URL
  bootstrap_secret_env: ZUBRIUM_BOOTSTRAP_SECRET
  s3_endpoint: http://obs-minio:5000
  s3_region: us-east-1
  s3_bucket: zubrium-private
  s3_access_key_env: ZUBRIUM_S3_ACCESS_KEY
  s3_secret_key_env: ZUBRIUM_S3_SECRET_KEY
  s3_path_style: true
  # Только для доверенного изолированного MinIO внутри compose. Для удалённого
  # хранилища используйте HTTPS и false. Разрешён только точный хост, без wildcard.
  s3_allow_insecure_http: true
  s3_insecure_allowed_hosts:
    - obs-minio
  atlas_binary: atlas
  migration_lock_timeout: 30s
  access_groups:
    content: 2
    features: 2
    forms_schemas: 2
    forms_submissions: 2
    router_routes: 2
    coordinator_jobs: 2
  min_connections: 0
  max_connections: 32
  connect_timeout: 10s
  max_lifetime: 1h
  max_idle_time: 10m
  health_interval: 30s
  max_metadata_bytes: 65536
  max_object_bytes: 104857600
  cache:
    max_bytes: 67108864
    ttl: 10m
    max_object_bytes: 2097152
    access_cache:
      max_entries: 10000
      max_bytes: 8388608
      ttl: 1m
    warmup:
      enabled: true
      mode: strict
      timeout: 30s
      per_key_timeout: 5s
      concurrency: 4
      max_keys: 200
      retry:
        attempts: 2
        backoff: 200ms
      refresh_interval: 0s
      sources:
        inline: false
        published_artifacts: true
      targets:
        authorization: false
        metadata: true
        bytes: true
        router_manifests: true
        router_routes: true
      published_artifacts: []
      keys: []
  concurrency:
    storage:
      max_concurrent_reads: 16
      max_concurrent_authorizations: 16
      operation_timeout: 10s
      read_reserve: 4
    cache:
      shards: 8
      lru_promotion_interval: 1
      coalesce:
        enabled: true
        max_waiters: 32
        timeout: 5s
    invalidation:
      batch_size: 256
      batch_window: 10ms
  maintenance_interval: 1m
  maintenance_timeout: 30s
  pending_ttl: 1h
  maintenance_batch_size: 100
  session_idle_ttl: 8h
  session_absolute_ttl: 168h
  module_data:
    max_payload_bytes: 1048576
    max_index_bytes: 65536
    max_batch_bytes: 8388608
    max_page_bytes: 16777216
    max_selectors: 16
    max_selector_values: 64
    max_page_size: 100
    max_batch_operations: 64

loader:
  part_size_bytes: 1048576
  max_file_bytes: 104857600
  max_part_bytes: 1048576
  max_parts: 100
  concurrency:
    max_concurrent_commits: 4
    max_concurrent_session_lookups: 8
  session_ttl: 24h
  commit_timeout: 5m
  mode: auto
  buffer_threshold_bytes: 2097152
  max_buffered_bytes: 16777216
  session_cache_entries: 10000
  session_cache_max_bytes: 8388608
  session_cache_ttl: 1m
  cleanup_interval: 1m
  cleanup_batch_size: 100

admin:
  concurrency:
    http:
      max_in_flight: 128
      request_timeout: 30s

router:
  cache:
    manifests:
      enabled: true
      max_entries: 512
      max_bytes: 33554432
      ttl: 5m
    routes:
      enabled: true
      max_entries: 4096
      max_bytes: 8388608
      ttl: 30s
    http:
      compression:
        enabled: true
        algorithms: [gzip]
        min_bytes: 1024
        max_uncompressed_bytes: 8388608
        max_compressed_bytes: 2097152
        media_types:
          - text/html
          - text/css
          - application/javascript
          - application/json
          - image/svg+xml
      vary:
        accept_encoding: true
        locale_from_cookie: no_store
  concurrency:
    http:
      max_in_flight: 512
      request_timeout: 30s
      per_route:
        enabled: false
        default_max_in_flight: 64
        overrides: []
    routes:
      max_concurrent_resolutions: 64

bus:
  concurrency:
    max_in_flight: 256
    per_operation:
      enabled: false
      default_max_in_flight: 32
      overrides: []

worker:
  archive:
    concurrency:
      enabled: true
      limit: 2
      poll_interval: 1s
      task_timeout: 30m
      lease_duration: 30s
  media:
    concurrency:
      enabled: true
      limit: 2
      poll_interval: 1s
      task_timeout: 30m
      lease_duration: 30s
  prerender:
    concurrency:
      enabled: true
      limit: 1
      poll_interval: 1s
      task_timeout: 30m
      lease_duration: 30s
  publication:
    concurrency:
      enabled: true
      limit: 2
      poll_interval: 1s
      task_timeout: 30m
      lease_duration: 30s

# Full profile registers the prerender worker; its sandbox must be configured
# explicitly. Adjust sandbox_platform to the host architecture if needed.
prerender:
  sandbox_image: zenika/alpine-chrome@sha256:1727e672844c93a15b5f32991febcf67d2d4f23ac4dbc2dec2f310c582aa36a2
  sandbox_platform: "linux/arm64"
  docker_binary: "/usr/local/bin/docker"
  staging_directory: "/var/lib/zubrium/prerender"
  cpus: "1"
  memory_limit_bytes: 268435456
  pids_limit: 64
  max_document_bytes: 1048576
  max_plan_bytes: 1048576
  max_artifacts: 4
  max_artifact_bytes: 2097152
  max_total_bytes: 8388608
  timeout: 90s

file_api:
  max_json_bytes: 1048576
  max_attribute_bytes: 65536
  max_groups_per_file: 16
  default_page_size: 25
  max_page_size: 100

admin_api:
  max_json_bytes: 1048576
  default_page_size: 50
  max_page_size: 200
  # HTTP-only изолированный стек; для HTTPS задайте true.
  session_cookie_secure: false
  allowed_origins:
    - http://127.0.0.1:18080

router_api:
  max_json_bytes: 1048576
  default_page_size: 25
  max_page_size: 100
  service_credential_env: ZUBRIUM_ROUTER_SERVICE_CREDENTIAL
  # Один Router process обслуживает одну настроенную branch.
  branch_id: main
  public_listen_address: 0.0.0.0:8081
  upload_staging_directory: /var/lib/zubrium/router-staging
  upload_max_file_bytes: 104857600
  upload_max_concurrent: 4
  upload_max_staged_bytes: 419430400
  upload_allowed_content_types:
    - application/pdf
    - image/jpeg
    - image/png
  form_session_cookie_secure: false
  locale_preference:
    enabled: true
    secure: false
    max_age: 86400s

forms_api:
  file_service_credential_env: ZUBRIUM_FORMS_FILE_SERVICE_CREDENTIAL
  visitor_session_ttl: 30m
  visitor_session_cleanup_interval: 1m
  export_max_concurrent: 2
  export_max_rows: 10000
  export_max_bytes: 33554432

content_api:
  service_credential_env: ZUBRIUM_CONTENT_SERVICE_CREDENTIAL
  locale: en-US

http:
  listen_address: 0.0.0.0:8080
  read_header_timeout: 5s
  read_timeout: 15m
  # Zero keeps long file streams open; uploads are bounded by File API limits.
  write_timeout: 0s
  idle_timeout: 2m
  shutdown_timeout: 30s
  max_header_bytes: 65536

coordinator:
  workflow_access_group: coordinator_jobs
  workflows_page_default: 25
  workflows_page_maximum: 100
  instance_lease: 30s
  heartbeat_interval: 5s
  retry_base: 2s
  retry_maximum: 2m
  max_attempts: 6
  max_workflow_tasks: 10000
  max_children_per_task: 128
  workflow_retention: 720h

observability:
  mode: otel                  # noop | file | otel
  min_level: info             # debug | info | warn | error
  service_version: dev        # не подменять фактическую build identity
  instance_id: zubrium-obs-1  # уникальный instance процесса
  # Атрибуты deployment.profile и router.branch задаёт composition root:
  # profile берётся из скомпилированного build profile (в compose — full),
  # branch — из router_api.branch_id. Эти поля не настраиваются в YAML.
  file:
    directory: /var/lib/zubrium/observability
    max_file_bytes: 16777216
    max_files: 4
  otlp:
    endpoint: http://otel-collector:4318
    insecure: true            # только внутри docker network
    headers_env: ZUBRIUM_OBS_OTLP_HEADERS
    timeout: 5s
