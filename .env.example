# Explicit example configuration. Supply real secrets via environment/secret files.
ENGINE_IMAGE=ghcr.io/zubrium/cdn:latest
POSTGRES_DB=engine
POSTGRES_USER=engine
POSTGRES_PASSWORD=replace-with-database-secret
DATABASE_URL=postgres://engine:replace-with-database-secret@db:5432/engine?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTION_LIFETIME=1h
DATABASE_MAX_CONNECTION_IDLE_TIME=15m
DATABASE_HEALTH_CHECK_INTERVAL=30s
DATABASE_CONNECT_TIMEOUT=10s
MIGRATION_LOCK_TIMEOUT=60s
BOOTSTRAP_ADMIN_TOKEN=
HTTP_ADDR=:8080
HTTP_MAX_HEADER_BYTES=1048576
HEALTH_CHECK_TIMEOUT=3s
BRANCHES='[{"name":"preview","httpAddr":":8081","corsOrigins":[],"indexable":false},{"name":"website","httpAddr":":8082","corsOrigins":[],"indexable":true}]'
MIGRATE_ON_START=true
LOG_LEVEL=info
TRUST_PROXY_HEADERS=false
MAX_JSON_BYTES=1048576
MAX_UPLOAD_BYTES=5368709120
FORM_RATE_LIMIT=20
ADMIN_PAGE_SIZE=200
PUBLIC_PAGE_SIZE=50
SUBMISSION_EXPORT_MAX_ROWS=10000
FORM_RATE_WINDOW=1m
FORM_RATE_MAX_CLIENTS=10000
FORM_RATE_SWEEP_INTERVAL=10m
READ_HEADER_TIMEOUT=10s
SHUTDOWN_TIMEOUT=20s
HTTP_READ_TIMEOUT=10m
HTTP_WRITE_TIMEOUT=10m
HTTP_IDLE_TIMEOUT=2m
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:8080
S3_REGION=us-east-1
S3_BUCKET=engine-files
S3_ACCESS_KEY=replace-with-storage-key
S3_SECRET_KEY=replace-with-storage-secret
S3_FORCE_PATH_STYLE=true
S3_ENSURE_BUCKET=true
S3_STARTUP_TIMEOUT=60s
S3_RETRY_INTERVAL=2s
MEDIA_RENDITION_LEASE=20m
MEDIA_WORKER_POLL_INTERVAL=1s
MEDIA_REDIRECT_CACHE_TTL=5m
RUNTIME_ASSET_CACHE_TTL=1h
MAX_FEATURE_BUILD_BYTES=268435456
FEATURE_BUILD_REGISTRATION_TIMEOUT=30s
DESIGN_PREVIEW_TTL=20m
# Files: references env names or secret paths, never literal integration keys.
FILES_MAX_BYTES=5368709120
FILES_PART_BYTES=8388608
FILES_UPLOAD_TTL=24h
FILES_CLEANUP_INTERVAL=5m
FILES_PROCESS_TIMEOUT=15m
FILES_OWNER_QUOTA_BYTES=53687091200
FILES_MAX_SESSIONS=10
FILES_LIST_LIMIT=100
FILES_RATE_LIMIT=1200
FILES_RATE_WINDOW=1m
FILES_RATE_MAX_CLIENTS=10000
FILES_LINK_MAX_TTL=15m
FILES_PUBLIC_BASE_URL=http://localhost:8080
FILES_TEMP_DIR=/data/uploads
FILES_SIGNING_KEY_ENV=ENGINE_FILE_SIGNING_SECRET
ENGINE_FILE_SIGNING_SECRET=
# Or use a mounted secret file instead: set FILES_SIGNING_KEY_FILE=/run/secrets/engine-file-signing-key and unset FILES_SIGNING_KEY_ENV.
FILE_SERVICES=[]
# Example FILE_SERVICES='[{"name":"domain-service","permissions":["upload","read","list","delete","link"],"keys":[{"env":"DOMAIN_FILE_KEY"}]}]'
PRERENDER_ENABLED=false
# Paths refer to preinstalled operator-managed files. Enable only in an image
# containing Node, Playwright and sandboxed Chromium; startup downloads nothing.
PRERENDER_NODE_PATH=/usr/bin/node
PRERENDER_WORKER_PATH=/app/scripts/prerender-worker.mjs
PRERENDER_PLAYWRIGHT_MODULE=/opt/playwright/node_modules/playwright/index.mjs
PRERENDER_BROWSER_PATH=/usr/bin/chromium
PRERENDER_CONCURRENCY=2
PRERENDER_QUEUE_SIZE=8
PRERENDER_CACHE_ENTRIES=200
PRERENDER_MAX_HTML_BYTES=4194304
PRERENDER_HEAP_MB=128
PRERENDER_VIEWPORT_WIDTH=1440
PRERENDER_VIEWPORT_HEIGHT=1000
PRERENDER_MAX_REQUESTS=200
PRERENDER_MAX_NETWORK_BYTES=67108864
PRERENDER_TIMEOUT=20s
PRERENDER_ATTEMPT_TIMEOUT=10s
PRERENDER_MAX_ATTEMPTS=2
PRERENDER_QUIET_INTERVAL=200ms
PRERENDER_CACHE_TTL=10m
SITEPACK_TEMP_DIR=/data/sitepacks
SITEPACK_MAX_BYTES=21474836480
SITEPACK_MAX_EXPANDED_BYTES=42949672960
SITEPACK_MAX_ENTRIES=10000
SITEPACK_MAX_INDEX_BYTES=16777216
SITEPACK_MAX_SVG_BYTES=8388608
# Maximum in-memory browser fallback when streaming file access is unavailable.
SITEPACK_BROWSER_FALLBACK_BYTES=67108864
